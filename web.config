<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    
    <!-- 1. Route HTTP traffic to node.exe via iisnode -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- 2. URL Rewrite Rules -->
    <rewrite>
      <rules>
        <!-- Disallow direct browser access to node-inspector files -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Serve uploaded files directly from /uploads without going through Node -->
        <rule name="UploadStaticContent" stopProcessing="true">
          <match url="^uploads/.*" />
          <action type="None" />
        </rule>

        <!-- Serve React static build assets directly from /build without invoking Node -->
        <rule name="ReactStaticContent" stopProcessing="true">
          <match url="^static/.*" />
          <action type="Rewrite" url="build{REQUEST_URI}" />
        </rule>

        <!-- Forward all dynamic application routes and API calls to server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 3. Security: Prevent downloading server config and sensitive dependencies -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- 4. Let Express format error messages instead of IIS serving blue screen 500 pages -->
    <httpErrors existingResponse="PassThrough" />

    <!-- 5. iisnode Configuration for Azure Windows App Service -->
    <iisnode
      nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot;"
      interceptor="&quot;%programfiles%\iisnode\interceptor.js&quot;"
      watchedFiles="web.config;server.js;package.json"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
    />

  </system.webServer>
</configuration>